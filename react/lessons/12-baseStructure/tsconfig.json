{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Môi trường phát triển và Bundler */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Các quy chuẩn code nghiêm ngặt (Strict Checks) */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* THIẾT LẬP PATH ALIAS: Tránh viết ../../../ quá sâu */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"] /* Định nghĩa alias @ tương ứng với thư mục src/ */
    }
  },
  "include": ["src"]
}
